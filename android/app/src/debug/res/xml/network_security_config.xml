<?xml version="1.0" encoding="utf-8"?>
<!--
  SOLO para debug (src/debug/, no existe en release): permite HTTP sin cifrar hacia
  los emuladores de Firebase (docs/02, CLAUDE.md → Comandos).
  - 10.0.2.2: el emulador de Android Studio ve al host de esa forma.
  - 127.0.0.1: un teléfono real conectado por USB, vía `adb reverse` (ver CLAUDE.md).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
