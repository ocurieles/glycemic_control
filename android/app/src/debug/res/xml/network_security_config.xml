<?xml version="1.0" encoding="utf-8"?>
<!--
  SOLO para debug (src/debug/, no existe en release): permite HTTP sin cifrar hacia
  los emuladores de Firebase (docs/02, CLAUDE.md → Comandos).
  - 10.0.2.2: el emulador de Android Studio ve al host de esa forma.
  - 127.0.0.1 + `adb reverse`: un teléfono real por USB (ver CLAUDE.md).
  - Cualquier otra IP: la Mac en la misma Wi-Fi (BuildConfig.EMULATOR_HOST, para probar
    dos teléfonos reales a la vez sin depender de un solo cable/`adb reverse`; ver
    docs/10). Como la IP de la Mac cambia de red en red, se permite cleartext para
    cualquier host en debug en vez de listar IPs una por una — nunca afecta a release,
    que usa su propio `AndroidManifest.xml` sin este `networkSecurityConfig`.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
