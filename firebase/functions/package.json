{
  "name": "functions",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "test": "vitest run --exclude src/__tests__/rules.test.ts --exclude src/__tests__/events.test.ts --exclude src/__tests__/missed.test.ts --exclude src/__tests__/libre-service.test.ts",
    "test:rules": "vitest run src/__tests__/rules.test.ts",
    "test:integration": "vitest run src/__tests__/events.test.ts src/__tests__/missed.test.ts src/__tests__/libre-service.test.ts",
    "test:all": "npm run test && npm run test:rules && npm run test:integration",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "test:watch": "vitest --exclude src/__tests__/rules.test.ts --exclude src/__tests__/events.test.ts --exclude src/__tests__/missed.test.ts --exclude src/__tests__/libre-service.test.ts",
    "lint": "eslint src --ext .ts",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "@types/luxon": "3.7.5",
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
